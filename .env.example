# Environment Variables Configuration
# Copy this file to .env and fill in the actual values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For local MongoDB: mongodb://localhost:27017/peercomm
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/peercomm
MONGODB_URI=mongodb://localhost:27017/peercomm

# JWT Secret (use a strong random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-1234567890

# ImageKit Configuration
# Get these from your ImageKit Dashboard: https://imagekit.io/dashboard
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-namespace
